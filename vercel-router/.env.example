# 複製成 .env（本地測試用）或在 Vercel Dashboard / `vercel env` 設定
# 金鑰本體不要進 git（.gitignore 已排除 .env 與 .env.local）

# 28 把 Groq 金鑰，用逗號/分號/空白分隔（就是 .env 裡的 GROQ_API_KEYS 整串）
GROQ_KEYS=

# 對外唯一入口 token（自己生一串夠長的隨機字，例如 32 bytes hex）
ROUTER_TOKEN=

# 可選：覆寫模型梯隊
# MODEL_LADDER=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b,allam-2-7b
